{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "vivek2962.com" }],
      "destination": "https://www.vivek2962.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ]
}
